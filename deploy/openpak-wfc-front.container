[Unit]
Description=OpenPak Wii/DS game-port front: real player addresses for GPCM, server browser, QR2, NATNEG (PROXY v2)
Wants=openpak-wfc-gpcm.service openpak-wfc-serverbrowser.service openpak-wfc-qr2.service openpak-wfc-natneg.service
After=openpak-wfc-gpcm.service openpak-wfc-serverbrowser.service openpak-wfc-qr2.service openpak-wfc-natneg.service

[Container]
ContainerName=openpak-wfc-front
# Pinned: deploy by changing the tag (no auto-update in front of the game ports).
Image=ghcr.io/openpak/wfc-front:0.1.0
# pasta keeps players' addresses (like openpak-edge). -T/-U reach the services' proxy ports,
# which they publish on the host's loopback only.
Network=pasta:-T,29950,-T,28950,-U,27950,-U,27951
PublishPort=0.0.0.0:39900:39900/tcp
PublishPort=0.0.0.0:38910:38910/tcp
PublishPort=0.0.0.0:37900:37900/udp
PublishPort=0.0.0.0:37901:37901/udp
Environment=FRONT_TCP=39900=127.0.0.1:29950,38910=127.0.0.1:28950
Environment=FRONT_UDP=37900=127.0.0.1:27950,37901=127.0.0.1:27951

[Service]
Restart=always

[Install]
WantedBy=default.target
